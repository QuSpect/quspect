#: quspect.synthesis.two_qubit.TwoQubitKAK:25
#: quspect.synthesis.two_qubit.TwoQubitKAK:31
#: ../mergewt/quspect/transpiler/_consolidate.py:docstring
#: quspect.transpiler._consolidate.ConsolidationStats:42
#: quspect.transpiler._consolidate.ConsolidationStats:49
#: ../mergewt/quspect/transpiler/_transpile.py:docstring
#: quspect.transpiler._transpile.TranspileStats:83
#: quspect.transpiler._transpile.TranspileStats:98
#: quspect.transpiler._transpile.TranspileStats:116

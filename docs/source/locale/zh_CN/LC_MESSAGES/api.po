msgid "Number of classical bits."
msgstr ""

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.begin_transaction:1
msgid "Start (or nest into) an undo journal for edge modifications."
msgstr "开始（或嵌套进入）一个用于记录边修改的撤销日志。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.begin_transaction:3
msgid ""
"While a transaction is open, edge insertions and removals (also those "
"performed by :meth:`remove_node`, whose node removal itself is *not* undone) "
"are journaled so that :meth:`rollback` can restore the exact previous edge "
"order."
msgstr ""
"事务处于打开状态时，边的插入和删除（包括 :meth:`remove_node` 执行的边操作，但"
"节点删除本身\\ *不会*\\ 被撤销）都会被记入日志，以便 :meth:`rollback` 能够恢"
"复之前确切的边顺序。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.begin_transaction:8
msgid "A savepoint to pass to :meth:`rollback`."
msgstr "传给 :meth:`rollback` 的保存点。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.rollback:1
msgid "Undo all journaled edge modifications made after ``savepoint``."
msgstr "撤销在 ``savepoint`` 之后记入日志的所有边修改。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.rollback:3
msgid "A value returned by :meth:`begin_transaction`."
msgstr "由 :meth:`begin_transaction` 返回的值。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.rollback:5
msgid "If no transaction is open."
msgstr "当没有打开的事务时。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.end_transaction:1
msgid "Close the innermost transaction, keeping all modifications."
msgstr "关闭最内层的事务，保留所有修改。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.end_transaction:3
msgid "The journal is discarded when the outermost transaction ends."
msgstr "最外层事务结束时，日志会被丢弃。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of

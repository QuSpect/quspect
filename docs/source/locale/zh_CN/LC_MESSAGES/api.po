msgid "``min(D[a][b] + D[a][c], D[a][b] + D[b][c], D[a][c] + D[b][c]) - 1``."
msgstr "``min(D[a][b] + D[a][c], D[a][b] + D[b][c], D[a][c] + D[b][c]) - 1``。"

#: ../mergewt/quspect/transpiler/_routing.py:docstring of

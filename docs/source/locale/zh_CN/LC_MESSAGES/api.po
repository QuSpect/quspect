msgstr "源节点 ID。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.has_edge:4
#: quspect.dag.dag_circuit.DAGCircuit.remove_edge:6

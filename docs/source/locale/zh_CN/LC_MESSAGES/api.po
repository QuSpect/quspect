msgstr ""

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.add_edge:4
msgid ""
"Internal flag for reordering passes. When True the incremental topological "
"numbering is not checked; the caller must "
"call :meth:`reverse_adjacent_edge_order` afterwards."
msgstr ""
"供重排序 pass 使用的内部标志。为 True 时不检查增量拓扑编号；调用方之后必须调"
"用 :meth:`reverse_adjacent_edge_order`。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.remove_edge:1
msgid "Remove one directed edge from the DAG."
msgstr "从 DAG 中删除一条有向边。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.remove_edge:3
msgid "Unlike :meth:`remove_node`, the endpoints are kept."
msgstr "与 :meth:`remove_node` 不同，边的两个端点会被保留。"

#: ../mergewt/quspect/dag/dag_circuit.py:docstring of
#: quspect.dag.dag_circuit.DAGCircuit.has_edge:3
#: quspect.dag.dag_circuit.DAGCircuit.remove_edge:5

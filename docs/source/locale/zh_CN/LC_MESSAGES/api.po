msgstr ""

#: ../mergewt/quspect/dag/compiler.py:docstring of quspect.dag.compiler:10
msgid ""
"For each instruction, create an OPERATION node and connect it to the "
"preceding nodes on the same qubit/bit lines"
msgstr ""

#: ../mergewt/quspect/dag/compiler.py:docstring of quspect.dag.compiler:12
